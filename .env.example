# Placeholders only. Use dedicated laboratory accounts, never production credentials.
# The CLI reads exported variables; it does not automatically load this file.
ODOO12_URL=http://localhost:8012
ODOO12_DB=odoo12_demo
ODOO12_USERNAME=
ODOO12_PASSWORD=
ODOO20_URL=http://localhost:8020
ODOO20_DB=odoo20_migration
ODOO20_USERNAME=
ODOO20_PASSWORD=

# Lab Docker/installer only: use each EXISTING database password; no defaults.
# Export these variables in the terminal before running Compose or install.sh.
LAB_PG12_PASSWORD=
LAB_PG20_PASSWORD=

# Independent pilot journal; export these separately from Odoo credentials.
JOURNAL_DB_HOST=127.0.0.1
JOURNAL_DB_PORT=55432
JOURNAL_DB_PASSWORD=
