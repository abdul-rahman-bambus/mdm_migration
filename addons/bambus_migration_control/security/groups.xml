<odoo>
    <record id="category_migration" model="ir.module.category">
        <field name="name">Migration Operations</field>
        <field name="sequence">90</field>
    </record>
    <record id="privilege_migration" model="res.groups.privilege">
        <field name="name">Migration Control</field>
        <field name="category_id" ref="category_migration"/>
    </record>
    <record id="group_migration_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_migration"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_migration_importer" model="res.groups">
        <field name="name">Journal Importer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_migration"/>
        <field name="implied_ids" eval="[(4, ref('group_migration_viewer'))]"/>
        <field name="comment">Trusted account used by the external journal monitor. Does not authorize contact migration or editing journal mirrors.</field>
    </record>
    <record id="group_contact_trial" model="res.groups">
        <field name="name">Contact Trial Migrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_migration"/>
        <field name="implied_ids" eval="[(4, ref('group_migration_importer'))]"/>
        <field name="comment">Explicit lab-only contact and historical chatter import. Separate from journal monitoring.</field>
    </record>
</odoo>
